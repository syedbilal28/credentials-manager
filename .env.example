# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Postgres connection string.
# Neon: use the *pooled* connection string (host contains "-pooler"), e.g.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Local (docker compose up -d):
#   postgresql://postgres:postgres@localhost:5433/credentials_manager
DATABASE_URL=

# Optional: direct (non-pooled) Neon connection, used only by `npm run db:migrate`.
# Falls back to DATABASE_URL. Vercel's Neon integration sets this automatically.
DATABASE_URL_UNPOOLED=

# 32 random bytes, base64-encoded. Generate with:  openssl rand -base64 32
# WARNING: if this key is lost, every stored credential is unrecoverable.
# Keep a copy in a password manager, separate from the database.
ENCRYPTION_KEY=
